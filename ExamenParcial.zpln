            1016.45|                116.9699056825797|              116.96929932399642|                116.9699056825797|\n+--------------------------+----------------------------+---------------------------------+--------------------------------+---------------------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=25"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=26"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752107772804_1460194534","id":"paragraph_1752107772804_1460194534","dateCreated":"2025-07-10T00:36:12+0000","dateStarted":"2025-07-10T00:45:31+0000","dateFinished":"2025-07-10T00:45:31+0000","status":"FINISHED","focus":false},{"text":"%md\n## Análisis del columnas tipo Double \n### Columna \"Temperature (C)\"","user":"anonymous","dateUpdated":"2025-07-10T01:36:38+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752111265083_38203780","id":"paragraph_1752111265083_38203780","dateCreated":"2025-07-10T01:34:25+0000","status":"FINISHED","focus":true,"dateFinished":"2025-07-10T01:36:38+0000","dateStarted":"2025-07-10T01:36:38+0000","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Análisis del columnas tipo Double</h2>\n<h3>Columna &ldquo;Temperature (C)&rdquo;</h3>\n\n</div>"}]}},{"text":"%md\n- Promt= \"Tengo un DataFrame en Spark llamado weatherCSV que contiene datos de temperaturas en la columna que se llama Temperature (C)\n,ya tengo una columna llamada \"Rango_Temperatura\" que agrupa las temperaturas en intervalos de 5 grados por ejemplo < -15,-15 a -10 \nasi sucesivamente ya que son demasiadas temperaturas únicas, como puedo ordenarlas ascedentemente\"","user":"anonymous","dateUpdated":"2025-07-10T01:53:52+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<ul>\n<li>Promt= &ldquo;Tengo un DataFrame en Spark llamado weatherCSV que contiene datos de temperaturas en la columna que se llama Temperature (C)<br />\n,ya tengo una columna llamada &ldquo;Rango_Temperatura&rdquo; que agrupa las temperaturas en intervalos de 5 grados por ejemplo &lt; -15,-15 a -10<br />\nasi sucesivamente ya que son demasiadas temperaturas únicas, como puedo ordenarlas ascedentemente&rdquo;</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752110691668_1284573665","id":"paragraph_1752110691668_1284573665","dateCreated":"2025-07-10T01:24:51+0000","dateStarted":"2025-07-10T01:53:52+0000","dateFinished":"2025-07-10T01:53:52+0000","status":"FINISHED","focus":true},{"text":"import org.apache.spark.sql.functions._\n\nval weatherBinned = weatherCSV\n  .withColumn(\"Rango_Temperatura\",\n    when(col(\"Temperature (C)\") < -15, \"< -15\")\n    .when(col(\"Temperature (C)\") < -10, \"-15 a -10\")\n    .when(col(\"Temperature (C)\") < -5, \"-10 a -5\")\n    .when(col(\"Temperature (C)\") < 0, \"-5 a 0\")\n    .when(col(\"Temperature (C)\") < 5, \"0 a 5\")\n    .when(col(\"Temperature (C)\") < 10, \"5 a 10\")\n    .when(col(\"Temperature (C)\") < 15, \"10 a 15\")\n    .when(col(\"Temperature (C)\") < 20, \"15 a 20\")\n    .when(col(\"Temperature (C)\") < 25, \"20 a 25\")\n    .when(col(\"Temperature (C)\") < 30, \"25 a 30\")\n    .when(col(\"Temperature (C)\") < 35, \"30 a 35\")\n    .otherwise(\">= 35\")\n  )\n  .withColumn(\"orden\",\n    when(col(\"Temperature (C)\") < -15, 1)\n    .when(col(\"Temperature (C)\") < -10, 2)\n    .when(col(\"Temperature (C)\") < -5, 3)\n    .when(col(\"Temperature (C)\") < 0, 4)\n    .when(col(\"Temperature (C)\") < 5, 5)\n    .when(col(\"Temperature (C)\") < 10, 6)\n    .when(col(\"Temperature (C)\") < 15, 7)\n    .when(col(\"Temperature (C)\") < 20, 8)\n    .when(col(\"Temperature (C)\") < 25, 9)\n    .when(col(\"Temperature (C)\") < 30, 10)\n    .when(col(\"Temperature (C)\") < 35, 11)\n    .otherwise(12)\n  )\n","user":"anonymous","dateUpdated":"2025-07-10T01:11:35+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mweatherBinned\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Formatted Date: timestamp, Summary: string ... 12 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752109451804_550724105","id":"paragraph_1752109451804_550724105","dateCreated":"2025-07-10T01:04:11+0000","dateStarted":"2025-07-10T01:11:35+0000","dateFinished":"2025-07-10T01:11:35+0000","status":"FINISHED","focus":false},{"text":"%md\n### Gráfica para vizualizar el rango del promedio que se presento entre los años 2006 al 2016","user":"anonymous","dateUpdated":"2025-07-10T01:33:01+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Gráfica para vizualizar el rango del promedio que se presento entre los años 2006 al 2016</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752110369789_1966075103","id":"paragraph_1752110369789_1966075103","dateCreated":"2025-07-10T01:19:29+0000","dateStarted":"2025-07-10T01:23:11+0000","dateFinished":"2025-07-10T01:23:11+0000","status":"FINISHED"},{"text":"val resumenPorRango = weatherBinned\n  .groupBy(\"Rango_Temperatura\", \"orden\")\n  .count()\n  .orderBy(\"orden\")\n\nz.show(resumenPorRango.select(\"Rango_Temperatura\", \"count\"))\n\n","user":"anonymous","dateUpdated":"2025-07-10T01:19:23+0000","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":true,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"Rango_Temperatura","index":0,"aggr":"sum"}],"groups":[{"name":"count","index":1,"aggr":"sum"}],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Rango_Temperatura\tcount\n< -15\t60\n-15 a -10\t386\n-10 a -5\t1886\n-5 a 0\t8055\n0 a 5\t14957\n5 a 10\t17092\n10 a 15\t16752\n15 a 20\t16588\n20 a 25\t11441\n25 a 30\t6469\n30 a 35\t2452\n>= 35\t315\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mresumenPorRango\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [Rango_Temperatura: string, orden: int ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=33"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=34"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752107777555_1718973379","id":"paragraph_1752107777555_1718973379","date